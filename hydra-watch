#!/usr/bin/env bash
# Watch Hydra's data and re-run the icon/shortcut fixer after meaningful changes.
set -euo pipefail

HYDRA_CONFIG_DIR="${HYDRA_CONFIG_DIR:-${XDG_CONFIG_HOME:-${HOME}/.config}/hydralauncher}"
ASSETS="${HYDRA_ASSETS_DIR:-${HYDRA_CONFIG_DIR}/Assets}"
DB_DIR="${HYDRA_DB_PATH:-${HYDRA_CONFIG_DIR}/hydra-db}"
LOG_DIR="${HYDRA_LOG_DIR:-${HYDRA_CONFIG_DIR}/logs}"
DESKTOP_DIR="${HYDRA_DESKTOP_DIR:-$(xdg-user-dir DESKTOP 2>/dev/null || printf '%s' "${HOME}/Desktop")}"
HYDRA_FIX_BIN="${HYDRA_FIX_BIN:-${HOME}/.local/bin/hydra-fix}"
DEBOUNCE="${HYDRA_WATCH_DEBOUNCE:-3}"
VERBOSE="${HYDRA_WATCH_VERBOSE:-0}"
LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/hydra-launcher-icon-fix-${UID}.lock"

log() {
  printf 'hydra-watch: %s\n' "$*" >&2
}

if [[ ! "${DEBOUNCE}" =~ ^[0-9]+$ ]]; then
  DEBOUNCE=3
fi

if ! command -v inotifywait >/dev/null 2>&1; then
  log "inotifywait is required (install inotify-tools)."
  exit 1
fi

if [[ ! -x "${HYDRA_FIX_BIN}" ]]; then
  log "fixer is not executable: ${HYDRA_FIX_BIN}"
  log "install it with ./install.sh or set HYDRA_FIX_BIN."
  exit 1
fi

trap 'log "stopping"; exit 0' INT TERM

run_fix() {
  local trigger="${1:-manual}"
  local -a arguments=()
  if (( VERBOSE )); then
    arguments+=(--verbose)
  fi

  log "change detected: ${trigger}"
  exec 9>"${LOCK_FILE}"
  if ! flock -n 9; then
    log "another fixer run is active; skipping this event"
    exec 9>&-
    return 0
  fi

  if ! "${HYDRA_FIX_BIN}" "${arguments[@]}"; then
    log "fixer failed; it will retry after the next relevant event"
  fi
  flock -u 9 || true
  exec 9>&-
}

build_watch_paths() {
  WATCH_PATHS=("${ASSETS}")
  if [[ -d "${DESKTOP_DIR}" ]]; then
    WATCH_PATHS+=("${DESKTOP_DIR}")
  fi
  if [[ -d "${LOG_DIR}" ]]; then
    WATCH_PATHS+=("${LOG_DIR}")
  fi
  if [[ -d "${DB_DIR}" ]]; then
    WATCH_PATHS+=("${DB_DIR}")
  fi
}

first_run=1
announced_wait=0
while :; do
  if [[ ! -d "${ASSETS}" ]]; then
    if (( announced_wait == 0 )); then
      log "waiting for Hydra assets directory: ${ASSETS}"
      announced_wait=1
    fi
    sleep 5
    continue
  fi

  if (( first_run )); then
    run_fix "startup"
    first_run=0
  fi

  build_watch_paths
  log "watching: ${WATCH_PATHS[*]}"

  set +e
  inotifywait -m -r -q --format '%w%f' \
    -e create -e moved_to -e modify -e close_write \
    "${WATCH_PATHS[@]}" 2>&1 |
    while IFS= read -r changed; do
      case "${changed}" in
        *.desktop|*.ico|*.png|*.webp|*.jpg|*.jpeg|*.ldb|*.log|*/CURRENT|*/MANIFEST-*|*/steam-*)
          trigger="${changed}"
          # Absorb the burst of events Hydra produces while writing a file.
          while IFS= read -r -t "${DEBOUNCE}" next_event; do
            trigger="${next_event}"
          done
          run_fix "${trigger}"
          ;;
      esac
    done
  status=${PIPESTATUS[0]}
  set -e

  log "inotifywait stopped (status ${status}); reconnecting in 3s"
  sleep 3
done
