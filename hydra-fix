#!/usr/bin/env python3
"""Launcher for both a source checkout and an installed copy.

The installer copies the ``hydra_fix`` package to
``${XDG_DATA_HOME:-~/.local/share}/hydra-launcher-icon-fix`` and installs this
small wrapper in ``~/.local/bin``.
"""
from __future__ import annotations

import os
import sys
from pathlib import Path


def _find_package() -> Path:
    candidates = []
    override = os.environ.get("HYDRA_FIX_PACKAGE_DIR")
    if override:
        candidates.append(Path(override).expanduser())
    candidates.append(Path(__file__).resolve().parent)
    xdg_data = Path(
        os.environ.get("XDG_DATA_HOME", str(Path.home() / ".local" / "share"))
    ).expanduser()
    candidates.append(xdg_data / "hydra-launcher-icon-fix")
    for candidate in candidates:
        if (candidate / "hydra_fix" / "__init__.py").is_file():
            return candidate
    raise SystemExit(
        "hydra-fix: cannot find the hydra_fix package. "
        "Reinstall with ./install.sh or set HYDRA_FIX_PACKAGE_DIR."
    )


sys.path.insert(0, str(_find_package()))

from hydra_fix.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
